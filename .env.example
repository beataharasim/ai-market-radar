# Optional: CoinGecko demo key (improves rate limits)
COINGECKO_API_KEY=

# LLM (optional – without it you get rule-based report)
# OpenAI-compatible (OpenAI, OpenRouter, Groq, DeepSeek, Kimi, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Or Anthropic-style
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_BASE_URL=
